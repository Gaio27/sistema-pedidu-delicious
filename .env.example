DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=django-insecure-development-key-change-in-production-123456789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
# For SQLite (local default if no postgres running):
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL:
# DATABASE_URL=postgres://celvas_user:celvas_password@localhost:5432/celvas_db

# Redis / Channels
# REDIS_URL=redis://localhost:6379/0

# Operational
DEFAULT_CURRENCY=USD
TIME_ZONE=Asia/Dili
RESTAURANT_NAME=Restaurante Sabor Dili
